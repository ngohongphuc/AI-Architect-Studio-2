# Chọn mô hình: gemini | openai | anthropic | ollama | none (mặc định none = chế độ quy tắc)
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna        # openai: gpt-6-luna | gpt-6.1-terra | gpt-6.1-sol
# GOOGLE_API_KEY=...
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
# LLM_PRICE_PER_MTOK=0.6        # USD / 1 triệu token, để ước tính chi phí API
MAX_ITERATIONS=3
# USE_CHROMA=1                  # dùng ChromaDB thay cho BM25

# ---- Gán model riêng cho từng agent (không khai báo thì dùng LLM_PROVIDER / LLM_MODEL chung) ----
# Hậu tố: _PROJECT_MANAGER | _REQUIREMENTS_ANALYST | _CONCEPT_ARCHITECT | _ARCHITECT
#          _DRAFTER | _REVIEWER | _FENGSHUI_ADVISOR | _COST_ESTIMATOR | _FINAL_REVIEWER
# LLM_PROVIDER_PROJECT_MANAGER=gemini
# LLM_MODEL_REQUIREMENTS_ANALYST=gemini-2.5-pro
# LLM_PROVIDER_CONCEPT_ARCHITECT=anthropic
# LLM_MODEL_CONCEPT_ARCHITECT=claude-sonnet-5-5
# LLM_TEMPERATURE_ARCHITECT=0.7
# LLM_PROVIDER_REVIEWER=ollama
# LLM_MODEL_REVIEWER=qwen2.5:7b
# LLM_PROVIDER_DRAFTER=none          # Họa viên không cần LLM
